.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Jekyll 빌드 산출물 ─────────────────────────────────────
_site/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock
vendor/

# 로컬 검증용 임시 파일
_preview*.html
_probe.html
_frame.html

# 인쇄용 사진 원본 (웹용 파생본 assets/profile.jpg 만 공개)
imgs/
