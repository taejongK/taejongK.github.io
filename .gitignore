# ═══════════════════════════════════════════════════════════
#  공개 저장소 (GitHub Pages). 아래 항목은 절대 커밋되면 안 된다
# ═══════════════════════════════════════════════════════════

# ── 시크릿 (실제 API 키 포함) ──────────────────────────────
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env_sample
*.key
*.pem
credentials.json

# ── 프로젝트 소스 전체 (비공개) ────────────────────────────
# 실제 API 키, 고객 상담 원본 데이터, 벡터 DB 포함
projects/

# ── 개인정보 포함 원본 (비공개) ────────────────────────────
# resume.md · portfolio/*.md 는 공개 원본이라 커밋한다(빌드가 원본까지 금칙어 검사).
# 연봉 등 비공개 정보는 resume.md 에 적지 않는다. 산출물인 제출본만 비공개다.
resume_submit.md
resume_submit.docx
# 슬라이드 덱 원본과 산출물. 제출용이므로 저장소에 올리지 않는다.
slides/

# 사내 문자열 차단 목록과 모자이크 전 원본 이미지
portfolio/_guard.py
portfolio/_originals/
references/
my_profile/
# 지원 현황·회사별 정리 메모
appling_list/
# 진로 설계 개인 메모 (방향·역량 격차·회고)
career_plan/

# ── 도구 상태 ──────────────────────────────────────────────
.omc/
.claude/
CLAUDE.md

# ── OS / 편집기 ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Jekyll 빌드 산출물 ─────────────────────────────────────
_site/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock
vendor/

# 로컬 검증용 임시 파일
_preview*.html
_probe.html
_frame.html

# 인쇄용 사진 원본 (웹용 파생본 assets/profile.jpg 만 공개)
imgs/
